# Variables de entorno — WhatsApp Family Box
# Copia este archivo como .env y completa con tus valores reales.
# NUNCA subas .env al repositorio.

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
# Token para verificar que los webhooks vienen de Meta
WEBHOOK_VERIFY_TOKEN=family-box-test

# Access Token de la app de Meta (Dashboard → WhatsApp → Configuración básica)
WHATSAPP_TOKEN=

# ID del número de teléfono de la WABA (Dashboard → Números de teléfono)
PHONE_NUMBER_ID=

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Lista de números de WhatsApp autorizados para interactuar con la caja.
# Formato: código de país + número, separados por comas. Sin espacios ni +.
# Ejemplo: 573001234567,573009876543
AUTHORIZED_NUMBERS=
